# Reconcilr environment configuration (placeholders only — never commit a real .env file)

# Backend runtime
APP_ENV=development
DATABASE_URL=sqlite:///./reconcilr.db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_BYTES=10485760
REQUEST_ACCESS_RATE_LIMIT=5

# Optional LLM / AI settings (leave blank to run fully offline with verified deterministic templates)
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
LLM_REDACT=0

# Optional OCR for scanned PDFs/images (requires pytesseract installed)
EXTRACTION_OCR=0

# Demo user seed script passwords (used only by: python -m scripts.seed_users)
DEMO_ADMIN_PASSWORD=
DEMO_ANALYST_PASSWORD=
DEMO_APPROVER_PASSWORD=
DEMO_AUDITOR_PASSWORD=

# Frontend (optional override in frontend/.env)
VITE_API_URL=http://127.0.0.1:8000
